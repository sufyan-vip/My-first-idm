/* =====================================================================
   IDM Pro – Light theme
   Palette:
     background  #f5f6fa
     cards       #ffffff (soft shadow via borders)
     accent      #0984e3
     text        #2d3436 / #636e72
   ===================================================================== */

* {
    font-family: "Segoe UI", "Microsoft YaHei", "Noto Sans", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: #f5f6fa;
    color: #2d3436;
}

QWidget {
    color: #2d3436;
    background: transparent;
}

QLabel { background: transparent; }
QLabel#windowTitle { font-size: 16px; font-weight: 600; }
QLabel#secondaryText, QLabel#dim { color: #636e72; font-size: 11px; }
QLabel#accentText { color: #0984e3; }
QLabel#successText { color: #00946e; }
QLabel#warningText { color: #c98a10; }
QLabel#errorText   { color: #d63031; }

/* menu */
QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #dfe4ea;
    padding: 2px;
}
QMenuBar::item { background: transparent; padding: 5px 12px; border-radius: 6px; }
QMenuBar::item:selected { background: #e3f0fb; }
QMenu {
    background: #ffffff;
    border: 1px solid #dfe4ea;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 6px; }
QMenu::item:selected { background: #0984e3; color: #ffffff; }
QMenu::separator { height: 1px; background: #dfe4ea; margin: 4px 8px; }

/* toolbar */
QToolBar { background: #ffffff; border: none; border-bottom: 1px solid #dfe4ea; padding: 4px; spacing: 4px; }
QToolButton {
    background: transparent; border: none; border-radius: 8px;
    padding: 6px 10px; font-size: 14px; color: #2d3436;
}
QToolButton:hover { background: #e3f0fb; }
QToolButton:pressed { background: #0984e3; color: #ffffff; }
QToolButton:disabled { color: #b2bec3; }

/* buttons */
QPushButton {
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 7px 16px;
    color: #2d3436;
}
QPushButton:hover { background: #eef2f7; }
QPushButton:pressed { background: #e3f0fb; border-color: #0984e3; }
QPushButton:disabled { background: #f1f3f5; color: #b2bec3; }

QPushButton#primaryButton, QPushButton[accent="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1e93f0, stop:1 #0984e3);
    border: none;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryButton:hover, QPushButton[accent="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3aa1f4, stop:1 #1a8ff0);
}
QPushButton#primaryButton:pressed { background: #0868b3; }
QPushButton#primaryButton:disabled { background: #b8c4ce; color: #8a97a3; }

QPushButton#dangerButton { background: #ffe3e3; border-color: #f5b5b5; color: #c0392b; }
QPushButton#dangerButton:hover { background: #ffd0d0; }

/* inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit {
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    padding: 6px 10px;
    selection-background-color: #0984e3;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QDateTimeEdit:focus { border: 1px solid #0984e3; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: #b2bec3; background: #f1f3f5; }

QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #636e72;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d0d7de;
    selection-background-color: #0984e3;
    selection-color: #ffffff;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px; background: #eef2f7; border: none;
}

/* progress */
QProgressBar {
    background: #e1e6ec;
    border: none;
    border-radius: 7px;
    text-align: center;
    color: #2d3436;
    font-size: 11px;
    height: 16px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0984e3, stop:1 #74b9ff);
    border-radius: 7px;
}
QProgressBar[mode="completed"]::chunk { background: #00b894; }
QProgressBar[mode="failed"]::chunk { background: #e17055; }
QProgressBar[mode="paused"]::chunk { background: #fdcb6e; }
QProgressBar[mode="queued"]::chunk { background: #74a9d8; }

/* list & tabs */
QListWidget { background: transparent; border: none; outline: none; padding: 4px; }
QListWidget::item {
    border-radius: 10px;
    margin: 3px 2px;
    padding: 8px;
    background: #ffffff;
    border: 1px solid #e1e6ec;
}
QListWidget::item:hover { background: #f0f7ff; }
QListWidget::item:selected {
    background: rgba(9, 132, 227, 40);
    border: 1px solid #0984e3;
}

QTabBar::tab {
    background: transparent;
    color: #636e72;
    padding: 7px 18px;
    margin-right: 4px;
    border-radius: 8px;
    font-weight: 500;
}
QTabBar::tab:selected { background: #0984e3; color: #ffffff; font-weight: 600; }
QTabBar::tab:hover:!selected { background: #e3f0fb; color: #2d3436; }

/* status bar */
QStatusBar {
    background: #eef1f5;
    color: #636e72;
    border-top: 1px solid #dfe4ea;
}
QStatusBar QLabel { background: transparent; color: #636e72; padding: 0 8px; }

/* groupbox */
QGroupBox {
    border: 1px solid #d0d7de;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
    background: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #0984e3;
}

/* checks */
QCheckBox, QRadioButton { background: transparent; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid #b2bec3;
    background: #ffffff;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #0984e3; border-color: #0984e3;
}

/* tables */
QTableWidget, QTableView {
    background: #ffffff;
    alternate-background-color: #f7f9fc;
    gridline-color: #e1e6ec;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    selection-background-color: rgba(9, 132, 227, 40);
}
QHeaderView::section {
    background: #f1f3f5;
    color: #636e72;
    border: none;
    border-bottom: 1px solid #d0d7de;
    padding: 8px;
    font-weight: 600;
}
QTableWidget::item:selected { background: rgba(9, 132, 227, 40); color: #2d3436; }

/* scrollbars */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #c8d0d8; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #0984e3; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #c8d0d8; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #0984e3; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* misc */
QSplitter::handle { background: #dfe4ea; width: 2px; }
QToolTip {
    background: #ffffff;
    color: #2d3436;
    border: 1px solid #0984e3;
    padding: 6px;
    border-radius: 6px;
}
QDateEdit, QTimeEdit {
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    padding: 4px 8px;
}
QDateTimeEdit::drop-down { border: none; width: 20px; }

QWidget#downloadCard {
    background: #ffffff;
    border: 1px solid #e1e6ec;
    border-radius: 10px;
}
QWidget#graphPanel {
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 10px;
}
